# Nach `pnpm --filter @call-a-ride/backend deploy:dev` aus den Stack-Outputs übernehmen
# und diese Datei als .env speichern (wird nicht committet).
EXPO_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.eu-central-1.amazonaws.com
EXPO_PUBLIC_WS_URL=wss://xxxxxxxxxx.execute-api.eu-central-1.amazonaws.com/dev
EXPO_PUBLIC_USER_POOL_ID=eu-central-1_xxxxxxxxx
EXPO_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Key-Wert: aws location describe-key --key-name car-dev-maps --query Key --output text
EXPO_PUBLIC_MAP_STYLE_URL=https://maps.geo.eu-central-1.amazonaws.com/v2/styles/Standard/descriptor?key=<KEY>&color-scheme=Light
EAS_PROJECT_ID=
