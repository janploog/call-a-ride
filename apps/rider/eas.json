{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "APP_VARIANT": "development",
        "EAS_PROJECT_ID": "REPLACE_NACH_EAS_INIT",
        "EXPO_PUBLIC_API_URL": "https://REPLACE-dev.execute-api.eu-central-1.amazonaws.com",
        "EXPO_PUBLIC_WS_URL": "wss://REPLACE-dev.execute-api.eu-central-1.amazonaws.com/dev",
        "EXPO_PUBLIC_USER_POOL_ID": "eu-central-1_REPLACE_DEV",
        "EXPO_PUBLIC_USER_POOL_CLIENT_ID": "REPLACE_DEV",
        "EXPO_PUBLIC_MAP_STYLE_URL": "https://maps.geo.eu-central-1.amazonaws.com/v2/styles/Standard/descriptor?key=REPLACE_DEV&color-scheme=Light",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_REPLACE"
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "EAS_PROJECT_ID": "REPLACE_NACH_EAS_INIT",
        "EXPO_PUBLIC_API_URL": "https://REPLACE-dev.execute-api.eu-central-1.amazonaws.com",
        "EXPO_PUBLIC_WS_URL": "wss://REPLACE-dev.execute-api.eu-central-1.amazonaws.com/dev",
        "EXPO_PUBLIC_USER_POOL_ID": "eu-central-1_REPLACE_DEV",
        "EXPO_PUBLIC_USER_POOL_CLIENT_ID": "REPLACE_DEV",
        "EXPO_PUBLIC_MAP_STYLE_URL": "https://maps.geo.eu-central-1.amazonaws.com/v2/styles/Standard/descriptor?key=REPLACE_DEV&color-scheme=Light",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_REPLACE"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EAS_PROJECT_ID": "REPLACE_NACH_EAS_INIT",
        "EXPO_PUBLIC_API_URL": "https://REPLACE-prod.execute-api.eu-central-1.amazonaws.com",
        "EXPO_PUBLIC_WS_URL": "wss://REPLACE-prod.execute-api.eu-central-1.amazonaws.com/prod",
        "EXPO_PUBLIC_USER_POOL_ID": "eu-central-1_REPLACE_PROD",
        "EXPO_PUBLIC_USER_POOL_CLIENT_ID": "REPLACE_PROD",
        "EXPO_PUBLIC_MAP_STYLE_URL": "https://maps.geo.eu-central-1.amazonaws.com/v2/styles/Standard/descriptor?key=REPLACE_PROD&color-scheme=Light",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_live_REPLACE"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "REPLACE@example.com",
        "ascAppId": "REPLACE_ASC_APP_ID_BETA",
        "appleTeamId": "REPLACE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "appleId": "REPLACE@example.com",
        "ascAppId": "REPLACE_ASC_APP_ID",
        "appleTeamId": "REPLACE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "production"
      }
    }
  }
}
